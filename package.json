{
  "name": "blh",
  "version": "0.1.0",
  "description": "blh — a coding agent CLI (TypeScript)",
  "keywords": [
    "cli",
    "coding-agent",
    "ai",
    "openai",
    "agent"
  ],
  "license": "UNLICENSED",
  "author": {
    "name": "lmbh",
    "email": "onlylovezr@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Imthesea/blh-cc.git"
  },
  "type": "module",
  "bin": {
    "blh": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:web": "pnpm --filter @blh/web build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "dev": "tsx src/cli/main.ts",
    "dev:yes": "tsx src/cli/main.ts --dangerously-skip-permissions",
    "web:server": "tsx src/cli/main.ts web --dev",
    "web:client": "pnpm --filter @blh/web dev",
    "web:prod": "pnpm build && pnpm build:web && tsx src/cli/main.ts web"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@blh/logger": "workspace:*",
    "@blh/web-server": "workspace:*",
    "dotenv": "^16.0.0",
    "openai": "^4.77.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
